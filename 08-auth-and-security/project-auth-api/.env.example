# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Run the server with:  node --env-file=.env server.js  (or: npm start)

# Your PostgreSQL password (same one you use for psql).
PGPASSWORD=your_db_password_here

# The secret used to SIGN and VERIFY JWTs. Anyone with this can forge tokens for ANY
# user — guard it. Use a long random string (e.g. run in node:
#   require("crypto").randomBytes(48).toString("hex")
# In production this MUST differ from dev and never live in git.
JWT_SECRET=change_me_to_a_long_random_string
